PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost/contacarros
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
APP_BASE_PATH=/contacarros
PUBLIC_HOST=localhost
COOKIE_SECURE=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/contacarros?schema=public
PLACA_FIPE_BASE_URL=https://api.placafipe.com.br
PLACA_FIPE_TOKEN=seu-token-aqui

# IP Whitelist for Admin Operations (optional, comma-separated)
# Format: single IPs (127.0.0.1, ::1) or CIDR ranges (192.168.1.0/24, 2001:db8::/32)
# If not set, all IPs are allowed (whitelist disabled)
# Examples:
#   ADMIN_IP_WHITELIST=127.0.0.1,192.168.1.0/24,::1
#   ADMIN_IP_WHITELIST=203.0.113.0/24
# To disable whitelist:
ADMIN_IP_WHITELIST=127.0.0.1,::1
